# Runtime
NODE_ENV=development
PORT=8787
WEB_PORT=5173
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://starter:starter_dev_password@localhost:5432/starter_kit_gov

# Identity adapter: local | oidc | saml2
IDENTITY_ADAPTER=local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8787/auth/callback

# Audit HMAC (wajib di production — fail-fast bila kosong; produksi via KMS/Secret Manager)
AUDIT_HMAC_KEY=development-only-change-me

# Enkripsi field-level PII (NIK, dsb) — base64 32-byte. Generate: openssl rand -base64 32
# Wajib diset bila aplikasi memakai enkripsi field (lihat .ai/data-protection.md)
FIELD_ENCRYPTION_KEY=

# TTE adapter: mock-test-only | bsre-official | peruri-official | privy-official
TTE_ADAPTER=mock-test-only
TTE_API_URL=
TTE_CLIENT_ID=
TTE_CLIENT_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173
